{
  "name": "campuscode",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "CampusCode - plataforma académica con banco de ejercicios, asistente de IA, seguimiento de progreso y retos empresariales.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "start:production": "node --env-file=.env.production scripts/start-production.mjs",
    "set-password": "node scripts/set-password.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "test": "node --test tests/api.test.mjs tests/ai-providers.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.3.4"
  }
}
