# ---------------------------------------------------------------------------
# CampusCode · producción
# Copia este archivo como .env.production y completa los valores.
# NO subas .env.production al repositorio.
# ---------------------------------------------------------------------------

# NODE_ENV lo establece scripts/start-production.mjs al arrancar.
PORT=4000

# Dominio público. Incluye apex y www si ambos responderán.
APP_ORIGIN=https://campuscode.com,https://www.campuscode.com

# Genera un secreto distinto al de desarrollo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-de-produccion

# SQLite local. Si usas un VPS, monta este directorio como volumen persistente.
DB_PATH=./data/campuscode.db

# IA opcional. Sin clave, el asistente usa la guía local identificada.
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=45000
AI_MODE=live
