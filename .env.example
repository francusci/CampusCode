# ---------------------------------------------------------------------------
# CampusCode · Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env al repositorio ni expongas estas claves en el frontend.
# ---------------------------------------------------------------------------

# Servidor
PORT=4000
# No definas NODE_ENV aquí: en local debe quedar sin definir y en producción
# se exporta NODE_ENV=production en el entorno del despliegue. Definirlo como
# "development" en .env puede hacer que Vite incluya React de desarrollo.

# Secreto para firmar las sesiones (JWT). Genera uno aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos para peticiones mutantes (separados por coma).
APP_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite. Se crea automáticamente al arrancar.
DB_PATH=./data/campuscode.db

# ---------------------------------------------------------------------------
# Asistente de IA (opcional)
# CampusCode llama al proveedor SOLO desde el servidor. Si no hay clave, el
# asistente responde con la guía local y la interfaz lo indica.
#
# OpenAI:     AI_PROVIDER=openai     AI_BASE_URL=https://api.openai.com/v1
# DeepSeek:   AI_PROVIDER=openai     AI_BASE_URL=https://api.deepseek.com/v1
# OpenRouter: AI_PROVIDER=openai     AI_BASE_URL=https://openrouter.ai/api/v1
# Gemini:     AI_PROVIDER=openai     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Anthropic:  AI_PROVIDER=anthropic  AI_BASE_URL=https://api.anthropic.com/v1
#
# El modelo debe existir en el proveedor elegido. No inventes un nombre.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Tokens máximos de salida. Súbelo si el modelo usa razonamiento interno.
AI_MAX_TOKENS=4096
# Tiempo máximo de espera de la API de IA, en milisegundos.
AI_TIMEOUT_MS=45000
# "live" usa la API si hay clave; "local" fuerza la guía de estudio sin conexión.
AI_MODE=live

# ---------------------------------------------------------------------------
# PostgreSQL / Supabase (PENDIENTE DE ADAPTADOR)
# El servidor actual usa SQLite y NO lee estas variables todavía. Se incluyen
# como lista de comprobación para la migración descrita en docs/BASE-DE-DATOS.md.
# Definirlas no cambia la base de datos por sí solo: hace falta implementar el
# adaptador y migrar las consultas.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=          # solo servidor; nunca en el frontend

